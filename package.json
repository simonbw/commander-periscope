{
  "name": "commander-periscope",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/simonbw/commander-periscope",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "convex dev --start vite",
    "dev:local": "CONVEX_AGENT_MODE=anonymous convex dev --start vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "convex-test": "^0.0.69",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
